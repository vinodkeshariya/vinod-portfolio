# Copy to .env.local for local development (never commit real values).
# On Vercel: Project → Settings → Environment Variables.

# --- Payload CMS (/admin) ------------------------------------------------------
# Neon PostgreSQL connection string. The Vercel ↔ Neon integration adds it automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string that signs admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Vercel Blob store token — media uploads go to Blob when this is set (required on Vercel,
# optional locally: without it uploads are saved to the local /media folder).
BLOB_READ_WRITE_TOKEN=

# --- Contact form + blog emails (Resend) ---------------------------------------
RESEND_API_KEY=
# Optional sender once a domain is verified in Resend, e.g. "Vinod Keshariya <hello@yourdomain.com>"
CONTACT_FROM=

# --- AI (Gemini) — site assistant + weekly blog drafts ----------------------------
GEMINI_API_KEY=
# Optional: comma-separated chat models, best first
GEMINI_CHAT_MODELS=

# --- Blog approval links (same value in Vercel and the GitHub Action secrets) --
BLOG_REVIEW_SECRET=
# Fine-grained GitHub token (Contents + Pull requests: read/write on this repo) — Vercel + GitHub secrets
BLOG_GITHUB_TOKEN=
